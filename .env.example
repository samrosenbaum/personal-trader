# === Robinhood (primary) ===
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# To auto-generate 2FA codes, set your TOTP secret here.
# When setting up 2FA in Robinhood, choose "authenticator app",
# and copy the secret key (base32 string) before scanning the QR code.
ROBINHOOD_TOTP_SECRET=

# === Exchange API Keys ===
# Coinbase
COINBASE_API_KEY=
COINBASE_SECRET=
COINBASE_PASSPHRASE=

# Binance (optional)
BINANCE_API_KEY=
BINANCE_SECRET=

# Kraken (optional)
KRAKEN_API_KEY=
KRAKEN_SECRET=

# Bybit (optional - for derivatives)
BYBIT_API_KEY=
BYBIT_SECRET=

# === Data Providers ===
# CoinGecko Pro API key (optional, free tier works)
COINGECKO_API_KEY=

# === Alert Settings ===
# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (optional)
DISCORD_WEBHOOK_URL=

# === General Settings ===
# How often to scan markets (seconds)
SCAN_INTERVAL=300

# Risk tolerance: conservative, moderate, aggressive
RISK_PROFILE=moderate

# Portfolio value threshold for alerts (USD)
ALERT_THRESHOLD=1000

# Default quote currency for stablecoin rotation
STABLE_COIN=USDC

# Enable paper trading mode (no real trades)
PAPER_TRADING=true
